{
  "code_review": {
    "schema_version": 1,
    "is_software_project": true,
    "project_type": "full-stack web application \u2014 React/Vite SPA gallery + FastAPI REST/SSE backend showcasing eight AI application patterns",
    "build_system": {
      "tool": "uv (Python, root pyproject.toml) + npm/Vite (frontend/package.json)",
      "manifest": "pyproject.toml"
    },
    "commands": {
      "build": "npm --prefix frontend run build",
      "test": "uv run pytest",
      "lint": "uv run ruff check .",
      "typecheck": "uv run mypy backend",
      "run": "uv run uvicorn backend.app.main:app",
      "dev": "npm --prefix frontend run dev"
    },
    "deployment": {
      "paas": {
        "platform": "Render",
        "config_path": "render.yaml",
        "source": "render.yaml"
      }
    },
