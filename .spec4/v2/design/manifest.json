  "screens": [
    {
      "id": "project-view",
      "audience": "Developer running the pipeline",
      "purpose": "See the seven agents and their next action first, then the round's cost, then the round's artifact record.",
      "surfaces": [
        "Status Bar & Nav",
        "Agent Rows",
        "Round Cost Strip",
        "Round Tree",
        "Lane Legend"
      ]
    },
    {
      "id": "chat-view",
      "audience": "Developer running the pipeline",
      "purpose": "Converse with the active agent, see live run progress, run cost, and continue the pipeline.",
      "surfaces": [
        "Status Bar & Nav",
        "Agent Pipeline Row",
        "Gate Panel",
        "Gate Panel — Expanded",
        "Transcript",
        "Run Cost Strip",
        "Run Action Row",
        "Live Activity Indicator",
        "Composer",
        "Model & Status Line"
      ]
    },
    {
      "id": "artifact-view",
      "audience": "Developer reading the specs",
      "purpose": "Browse rounds on disk and read any artifact's content, status and location.",
      "surfaces": [
        "Status Bar & Nav",
        "Round Selector",
        "Round Tree",
        "Lane Legend",
        "Artifact File Pane",
        "Artifact Pane State Insets"
      ]
    },
    {
      "id": "picker-view",
      "audience": "Developer opening a project",
      "purpose": "Browse, create and select the working directory when none is remembered.",
      "surfaces": [
        "Status Bar & Nav",
        "Directory Path Entry",
        "Directory List",
        "Create Folder Row",
        "Select Directory Action"
      ]
    },
    {
      "id": "setup-view",
      "audience": "Developer configuring the default provider",
      "purpose": "Step 2 of setup — pick the default model and its reasoning effort.",
      "surfaces": [
        "Status Bar & Nav",
        "Setup Stepper",
        "Default Model Panel",
        "Setup Button Row"
      ]
    },
    {
      "id": "designer-view",
      "audience": "Developer running the Designer agent",
      "purpose": "Designer wizard, Preferences step — describe the visual direction before generating a mock.",
      "surfaces": [
        "Status Bar & Nav",
        "Agent Pipeline Row",
        "Designer Stepper",
        "Design Preferences Entry",
        "Designer Button Row",
        "Run Cost Strip"
      ]
    },
    {
      "id": "mode-inset",
      "audience": "Developer opening a directory that already has files",
      "purpose": "Ask once per session whether this is an existing project or a new one.",
      "surfaces": [
        "Status Bar & Nav",
        "Project Mode Question"
      ]
    }
  ],
